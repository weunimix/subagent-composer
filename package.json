{
  "name": "subagent-composer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Compile typed role definitions into DSH agent presets, and project the same roles into dsh_workflow agent() calls.",
  "main": "./dist/plugin/delegate.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/plugin/delegate.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "check:projections": "node scripts/check-projections.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./dist/cordis.patch.yml"
    }
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
